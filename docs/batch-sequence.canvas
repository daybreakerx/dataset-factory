{
	"nodes":[
		{"id":"7863e1828ede4888","type":"group","x":0,"y":840,"width":1120,"height":1440,"color":"#3b82f6","label":"loop 每个素材条目"},
		{"id":"76588cb708ae4bb7","type":"group","x":0,"y":2400,"width":1120,"height":640,"color":"#d97706","label":"alt：可重试失败（429 / 5xx / 网络）｜不可重试（400/401/403/404）"},
		{"id":"b38ad39143074838","type":"group","x":0,"y":140,"width":1120,"height":620,"color":"#3b82f6","label":"建批与发车"},
		{"id":"9a8b02464c69490e","type":"group","x":0,"y":4160,"width":1120,"height":440,"color":"#16a34a","label":"打包导出"},
		{"id":"802ff5a9fce74e39","type":"group","x":0,"y":3200,"width":1120,"height":320,"color":"#ef4444","label":"失败分类（alt 帧外）"},
		{"id":"1b964676cbee418e","type":"group","x":0,"y":3680,"width":1120,"height":320,"color":"#64748b","label":"停止"},
		{"id":"05f3af425e9a4ebe","type":"group","x":0,"y":4760,"width":1120,"height":320,"color":"#16a34a","label":"收尾"},
		{"id":"2681c4e12e6a42d9","type":"group","x":0,"y":-80,"width":1120,"height":150,"color":"#64748b","label":"参与方"},
		{"id":"792fbbe9478847ed","type":"text","text":"# 一轮跑批时序","x":0,"y":-260,"width":900,"height":50},
		{"id":"b2df208faf9944ed","type":"text","text":"打标：9 参与方 · 26 条消息；评测：7 参与方 · 12 条消息（下半部分）；灰色＝返回消息；↻＝自环；分组＝时序框（loop / alt）","x":0,"y":-180,"width":980,"height":40},
		{"id":"d0adb614eb974b27","type":"text","text":"**1 · 前端 → API**\n新建批次（两来源：素材组 / 工作目录）","x":20,"y":160,"width":560,"height":80},
		{"id":"07b1111cc53d40e3","type":"text","text":"**2 · API → workdir**\n读 imports.jsonl（登记：复制导入 / 就地采用）","x":20,"y":280,"width":560,"height":80},
		{"id":"892f389c583342f5","type":"text","text":"**3 · API → strategies**\n应用库策略 → 生成自包含快照 sN.json","x":20,"y":400,"width":560,"height":80},
		{"id":"7d671425f98b4682","type":"text","text":"注：快照损坏/被手改可发现；损坏旧快照不报错","x":600,"y":410,"width":400,"height":60,"color":"#d97706"},
		{"id":"8cdb030b16774d23","type":"text","text":"**4 · 前端 → API**\nPOST /runs/start（工作目录 + 批次快照 + 素材集）","x":20,"y":520,"width":560,"height":80},
		{"id":"5992eefba1234163","type":"text","text":"**5 · API → 编排**\n创建运行（run.json，并发占用锁；关机/忙时拒绝）","x":20,"y":640,"width":560,"height":80},
		{"id":"58791e5943774323","type":"text","text":"**6 · 编排 → labeling**\n串行提交条目","x":20,"y":900,"width":560,"height":80},
		{"id":"c3badc26edc34e97","type":"text","text":"注：续跑按素材哈希跳过已完成；排队中可覆盖发车","x":600,"y":910,"width":420,"height":60,"color":"#d97706"},
		{"id":"bb36701246754dd9","type":"text","text":"**25 · API → 前端**\n导出 ZIP（图文平铺，无 manifest，凭据不入包）","x":20,"y":4820,"width":560,"height":80,"color":"#64748b"},
		{"id":"237c5996dc0d4299","type":"text","text":"**26 · 编排 → 前端**\nSSE done（六分组汇总）","x":20,"y":4960,"width":560,"height":80,"color":"#64748b"},
		{"id":"ca80b6401c274f11","type":"text","text":"**7 · labeling → llm**\n组装请求（端点 + 提示词 + 图片/视频首帧）","x":20,"y":1040,"width":560,"height":80},
		{"id":"a0cd74cdc2444b4a","type":"text","text":"**8 · llm → Provider**\nHTTPS / SSE 发起对话","x":20,"y":1200,"width":560,"height":80},
		{"id":"a4ea90cb65444304","type":"text","text":"**9 · Provider → llm**\n流式 delta","x":20,"y":1360,"width":560,"height":80,"color":"#64748b"},
		{"id":"e0fc3731342c4f0c","type":"text","text":"**10 · llm → 编排**\ndelta（思考过程/正文，思考不入产物）","x":20,"y":1520,"width":560,"height":80,"color":"#64748b"},
		{"id":"1ccc41a5cd444c7a","type":"text","text":"**11 · 编排 → 前端**\nSSE start / delta / 六分组计数","x":20,"y":1680,"width":560,"height":80,"color":"#64748b"},
		{"id":"695064ccff3c4eb3","type":"text","text":"**12 · Provider → llm**\ndone","x":20,"y":1840,"width":560,"height":80,"color":"#64748b"},
		{"id":"a69005fc1de04e93","type":"text","text":"**13 · llm → 编排**\n完整回复","x":20,"y":2000,"width":560,"height":80,"color":"#64748b"},
		{"id":"49445dcd4dee40fc","type":"text","text":"**14 · 编排 ↻**\n写 items.jsonl 与 sN__主干.txt","x":20,"y":2160,"width":560,"height":80},
		{"id":"8f3a8dce185e4125","type":"text","text":"前端（打标页/策略页）｜API 层 api（12 路由）｜workdir 工作目录｜strategies 批次策略｜编排 tasks/runs｜打标引擎 labeling｜能力层 llm｜模型 Provider｜export 打包","x":20,"y":-40,"width":960,"height":80},
		{"id":"d26a06f7a1f349af","type":"text","text":"注：不可重试分支未画消息，直达失败分类","x":20,"y":2460,"width":560,"height":60,"color":"#d97706"},
		{"id":"c3a61c1672744871","type":"text","text":"**15 · Provider → llm**\n429 或 5xx","x":20,"y":2600,"width":560,"height":80,"color":"#64748b"},
		{"id":"7291cb2a34534e7c","type":"text","text":"**16 · llm ↻**\n遵循 Retry-After，1/2/4s+抖动，最多 3 次","x":20,"y":2760,"width":560,"height":80},
		{"id":"045b1079b8064f77","type":"text","text":"**17 · 编排 ↻**\n失败条目入常驻重试列表（跨会话持久）","x":20,"y":2920,"width":560,"height":80},
		{"id":"2a3cf6bd16bb41ae","type":"text","text":"**18 · llm → 编排**\n失败分类","x":20,"y":3260,"width":560,"height":80,"color":"#64748b"},
		{"id":"6efc925dd6374b7f","type":"text","text":"**19 · 编排 ↻**\n条目入失败/跳过分组并记录停因","x":20,"y":3400,"width":560,"height":80},
		{"id":"5c1be089be0b41c9","type":"text","text":"**20 · 前端 → API**\n停止（两档：已完成保留 / 已中断停因可见）","x":20,"y":3740,"width":560,"height":80},
		{"id":"69915c4ebeae466a","type":"text","text":"**21 · API → 编排**\n控制运行；停止后仍可续跑","x":20,"y":3880,"width":560,"height":80},
		{"id":"ae0cb480bdce4c13","type":"text","text":"**22 · 前端 → API**\n请求打包","x":20,"y":4220,"width":560,"height":80},
		{"id":"3d14b4d85338462f","type":"text","text":"**23 · API → export**\n生成打包计划：入包资格判定","x":20,"y":4360,"width":560,"height":80},
		{"id":"f29f48bda7b84a30","type":"text","text":"**24 · export ↻**\n将入包/被排除两清单逐条列原因；完整性哈希校验","x":20,"y":4490,"width":560,"height":80},
		{"id":"734fd4c0a52546ab","type":"text","text":"注：配对冲突默认入包；非 ASCII 文件名 001 三位定宽重命名","x":600,"y":4500,"width":500,"height":60,"color":"#d97706"},
		{"id":"ab12cd34ef560718","type":"text","text":"# 评测打分一轮时序","x":0,"y":5200,"width":900,"height":50},
		{"id":"bc23de45f0671829","type":"text","text":"与打标独立（eval 运行锁），可与打标并行；完整设计见同目录 eval-main-flow.canvas","x":0,"y":5260,"width":980,"height":40},
		{"id":"cd34ef560718293a","type":"group","x":0,"y":5330,"width":1120,"height":1380,"color":"#8b5cf6","label":"评测打分（独立运行）"},
		{"id":"de45f06718293a4b","type":"text","text":"入口（CLI / HTTP）｜api routes_eval｜eval runner｜workdir + strategies｜llm｜裁判 Provider｜report 聚合","x":20,"y":5360,"width":960,"height":80},
		{"id":"ef560718293a4b5c","type":"text","text":"**1 · 入口 → API**\n发起打分运行（POST /eval-batches/{eN}/runs 或 dsf eval run）","x":20,"y":5460,"width":560,"height":80},
		{"id":"f06718293a4b5c6d","type":"text","text":"**2 · API → eval runner**\n受理 202＋后台线程；同步预检引用与配置规则","x":20,"y":5560,"width":560,"height":80},
		{"id":"a178293a4b5c6d7e","type":"text","text":"**3 · eval runner → workdir**\n抢 eval run.lock（与打标 run.lock 独立）；读被测批次快照与产物","x":20,"y":5660,"width":560,"height":80},
		{"id":"b2893a4b5c6d7e8f","type":"text","text":"**4 · eval runner → llm**\n组装 judge 请求（素材＋候选 caption＋参照块；温度 0）","x":20,"y":5760,"width":560,"height":80},
		{"id":"c39a4b5c6d7e8f90","type":"text","text":"**5 · llm → Provider**\n结构化输出三级降级：json_schema → json_object → plain","x":20,"y":5860,"width":560,"height":80},
		{"id":"d4ab5c6d7e8f90a1","type":"text","text":"**6 · Provider → llm**\n评分 JSON＋理由；失败按可重试分类","x":20,"y":5960,"width":560,"height":80,"color":"#64748b"},
		{"id":"e5bc6d7e8f90a1b2","type":"text","text":"**7 · llm → eval runner**\n解析结果＋调用轨迹；写 scores.jsonl / pairs.jsonl","x":20,"y":6060,"width":560,"height":80,"color":"#64748b"},
		{"id":"f6cd7e8f90a1b2c3","type":"text","text":"**8 · eval runner ↻**\nSSE item-updated；人工题单生成（随机抽检可先、定向筛查在 judge 后）","x":20,"y":6160,"width":560,"height":80},
		{"id":"a7de8f90a1b2c3d4","type":"text","text":"**9 · 入口 → eval runner**\n人工打分 PUT /manual-scores（条目级、带标注者）；可随时补打","x":20,"y":6260,"width":560,"height":80},
		{"id":"b8ef90a1b2c3d4e5","type":"text","text":"**10 · eval runner → report**\n运行完成自动聚合五层：BT 排名／维度／κ／badcase／可复现","x":20,"y":6360,"width":560,"height":80},
		{"id":"c9f0a1b2c3d4e5f6","type":"text","text":"**11 · report ↻**\n写 reports/<run_id>.json 快照（当次配置＋运行 ID）","x":20,"y":6460,"width":560,"height":80},
		{"id":"da01b2c3d4e5f6a7","type":"text","text":"**12 · API → 入口**\nSSE run-finished；报告可读；人工 badcase 可加入重试列表","x":20,"y":6560,"width":560,"height":80,"color":"#64748b"},
		{"id":"eb12c3d4e5f6a7b8","type":"text","text":"注：人工抽检不依赖 judge，可先跑","x":600,"y":6260,"width":500,"height":60,"color":"#d97706"},
		{"id":"fc23d4e5f6a7b8c9","type":"text","text":"注：报告生成失败可按 run_id 重出；失败不推翻已完成的运行","x":600,"y":6400,"width":500,"height":60,"color":"#d97706"}
	],
