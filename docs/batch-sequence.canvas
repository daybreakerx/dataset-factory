{
	"nodes":[
		{"id":"792fbbe9478847ed","type":"text","x":0,"y":0,"width":900,"height":50,"text":"# 一轮跑批时序"},
		{"id":"b2df208faf9944ed","type":"text","x":0,"y":55,"width":980,"height":40,"text":"9 参与方 · 26 条消息；灰色＝虚线（返回）消息；↻＝自环；分组＝时序框（loop / alt）"},
		{"id":"2681c4e12e6a42d9","type":"group","x":0,"y":110,"width":1000,"height":150,"color":"#64748b","label":"参与方"},
		{"id":"8f3a8dce185e4125","type":"text","x":20,"y":160,"width":960,"height":80,"text":"前端（打标页/策略页）｜API 层 api（12 路由）｜workdir 工作目录｜strategies 批次策略｜编排 tasks/runs｜打标引擎 labeling｜能力层 llm｜模型 Provider｜export 打包"},
		{"id":"b38ad39143074838","type":"group","x":0,"y":300,"width":1000,"height":620,"color":"#3b82f6","label":"建批与发车"},
		{"id":"d0adb614eb974b27","type":"text","x":20,"y":360,"width":560,"height":80,"text":"**1 · 前端 → API**\n新建批次（两来源：素材组 / 工作目录）"},
		{"id":"07b1111cc53d40e3","type":"text","x":20,"y":450,"width":560,"height":80,"text":"**2 · API → workdir**\n读 imports.jsonl（登记：复制导入 / 就地采用）"},
		{"id":"892f389c583342f5","type":"text","x":20,"y":540,"width":560,"height":80,"text":"**3 · API → strategies**\n应用库策略 → 生成自包含快照 sN.json"},
		{"id":"7d671425f98b4682","type":"text","x":20,"y":630,"width":560,"height":60,"color":"#d97706","text":"注：快照损坏/被手改可发现；损坏旧快照不报错"},
		{"id":"8cdb030b16774d23","type":"text","x":20,"y":720,"width":560,"height":80,"text":"**4 · 前端 → API**\nPOST /runs/start（工作目录 + 批次快照 + 素材集）"},
		{"id":"5992eefba1234163","type":"text","x":20,"y":810,"width":560,"height":80,"text":"**5 · API → 编排**\n创建运行（run.json，并发占用锁；关机/忙时拒绝）"},
		{"id":"7863e1828ede4888","type":"group","x":0,"y":960,"width":1000,"height":980,"color":"#3b82f6","label":"loop 每个素材条目"},
		{"id":"58791e5943774323","type":"text","x":20,"y":1020,"width":560,"height":80,"text":"**6 · 编排 → labeling**\n串行提交条目"},
		{"id":"c3badc26edc34e97","type":"text","x":20,"y":1110,"width":560,"height":60,"color":"#d97706","text":"注：续跑按素材哈希跳过已完成；排队中可覆盖发车"},
		{"id":"ca80b6401c274f11","type":"text","x":20,"y":1200,"width":560,"height":80,"text":"**7 · labeling → llm**\n组装请求（端点 + 提示词 + 图片/视频首帧）"},
		{"id":"a0cd74cdc2444b4a","type":"text","x":20,"y":1290,"width":560,"height":80,"text":"**8 · llm → Provider**\nHTTPS / SSE 发起对话"},
		{"id":"a4ea90cb65444304","type":"text","x":20,"y":1380,"width":560,"height":80,"color":"#64748b","text":"**9 · Provider → llm**\n流式 delta"},
		{"id":"e0fc3731342c4f0c","type":"text","x":20,"y":1470,"width":560,"height":80,"color":"#64748b","text":"**10 · llm → 编排**\ndelta（思考过程/正文，思考不入产物）"},
		{"id":"1ccc41a5cd444c7a","type":"text","x":20,"y":1560,"width":560,"height":80,"color":"#64748b","text":"**11 · 编排 → 前端**\nSSE start / delta / 六分组计数"},
		{"id":"695064ccff3c4eb3","type":"text","x":20,"y":1650,"width":560,"height":80,"color":"#64748b","text":"**12 · Provider → llm**\ndone"},
		{"id":"a69005fc1de04e93","type":"text","x":20,"y":1740,"width":560,"height":80,"color":"#64748b","text":"**13 · llm → 编排**\n完整回复"},
		{"id":"49445dcd4dee40fc","type":"text","x":20,"y":1830,"width":560,"height":80,"text":"**14 · 编排 ↻**\n写 items.jsonl 与 sN__主干.txt"},
		{"id":"76588cb708ae4bb7","type":"group","x":0,"y":1980,"width":1000,"height":440,"color":"#d97706","label":"alt：可重试失败（429 / 5xx / 网络）｜不可重试（400/401/403/404）"},
		{"id":"d26a06f7a1f349af","type":"text","x":20,"y":2040,"width":560,"height":60,"color":"#d97706","text":"注：不可重试分支未画消息，直达失败分类"},
		{"id":"c3a61c1672744871","type":"text","x":20,"y":2130,"width":560,"height":80,"color":"#64748b","text":"**15 · Provider → llm**\n429 或 5xx"},
		{"id":"7291cb2a34534e7c","type":"text","x":20,"y":2220,"width":560,"height":80,"text":"**16 · llm ↻**\n遵循 Retry-After，1/2/4s+抖动，最多 3 次"},
		{"id":"045b1079b8064f77","type":"text","x":20,"y":2310,"width":560,"height":80,"text":"**17 · 编排 ↻**\n失败条目入常驻重试列表（跨会话持久）"},
		{"id":"802ff5a9fce74e39","type":"group","x":0,"y":2460,"width":1000,"height":230,"color":"#ef4444","label":"失败分类（alt 帧外）"},
		{"id":"2a3cf6bd16bb41ae","type":"text","x":20,"y":2520,"width":560,"height":80,"color":"#64748b","text":"**18 · llm → 编排**\n失败分类"},
		{"id":"6efc925dd6374b7f","type":"text","x":20,"y":2610,"width":560,"height":80,"text":"**19 · 编排 ↻**\n条目入失败/跳过分组并记录停因"},
		{"id":"1b964676cbee418e","type":"group","x":0,"y":2760,"width":1000,"height":230,"color":"#64748b","label":"停止"},
		{"id":"5c1be089be0b41c9","type":"text","x":20,"y":2820,"width":560,"height":80,"text":"**20 · 前端 → API**\n停止（两档：已完成保留 / 已中断停因可见）"},
		{"id":"69915c4ebeae466a","type":"text","x":20,"y":2910,"width":560,"height":80,"text":"**21 · API → 编排**\n控制运行；停止后仍可续跑"},
		{"id":"9a8b02464c69490e","type":"group","x":0,"y":3060,"width":1000,"height":440,"color":"#16a34a","label":"打包导出"},
		{"id":"ae0cb480bdce4c13","type":"text","x":20,"y":3120,"width":560,"height":80,"text":"**22 · 前端 → API**\n请求打包"},
		{"id":"3d14b4d85338462f","type":"text","x":20,"y":3210,"width":560,"height":80,"text":"**23 · API → export**\n生成打包计划：入包资格判定"},
		{"id":"f29f48bda7b84a30","type":"text","x":20,"y":3300,"width":560,"height":80,"text":"**24 · export ↻**\n将入包/被排除两清单逐条列原因；完整性哈希校验"},
		{"id":"734fd4c0a52546ab","type":"text","x":20,"y":3390,"width":560,"height":60,"color":"#d97706","text":"注：配对冲突默认入包；非 ASCII 文件名 001 三位定宽重命名"},
		{"id":"05f3af425e9a4ebe","type":"group","x":0,"y":3540,"width":1000,"height":230,"color":"#16a34a","label":"收尾"},
		{"id":"bb36701246754dd9","type":"text","x":20,"y":3600,"width":560,"height":80,"color":"#64748b","text":"**25 · API → 前端**\n导出 ZIP（图文平铺，无 manifest，凭据不入包）"},
		{"id":"237c5996dc0d4299","type":"text","x":20,"y":3690,"width":560,"height":80,"color":"#64748b","text":"**26 · 编排 → 前端**\nSSE done（六分组汇总）"},
		{"id":"39fdb11bad7b44bd","type":"text","x":0,"y":3850,"width":900,"height":30,"text":"复刻自 Dataset Factory 协作仓 asset/docs/batch-sequence.svg"}
	],
