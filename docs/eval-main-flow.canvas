{
	"nodes":[
		{"id":"g1","type":"group","x":600,"y":1140,"width":400,"height":320,"color":"4","label":"五层报告"},
		{"id":"a1","type":"text","text":"**① 建评测工作目录**\n公开测评集＝专用工作目录；自有素材目录同理","x":300,"y":0,"width":300,"height":70,"color":"4"},
		{"id":"b1","type":"text","text":"导入测试集素材\n走正常导入登记（出身可追溯）","x":60,"y":140,"width":260,"height":80,"color":"4"},
		{"id":"b2","type":"text","text":"摆放参照 caption\n落为**基准批次**：标记不跑批，防误跑覆盖","x":420,"y":140,"width":280,"height":80,"color":"4"},
		{"id":"c1","type":"text","text":"建候选批次 ×N\n同素材，按要评的变量建多套策略（模型／提示词／技能包／参数／抽帧率）","x":280,"y":290,"width":320,"height":90,"color":"4"},
		{"id":"c2","type":"text","text":"跑批产出 caption\n复用打标跑批（进度／重试／运行记录）","x":280,"y":430,"width":320,"height":70,"color":"4"},
		{"id":"d1","type":"text","text":"**judge 维度分全量**\n每条候选一次调用：各维度分＋无幻觉判定＋理由（温度 0、结构化输出）","x":280,"y":560,"width":320,"height":90,"color":"5"},
		{"id":"d2","type":"text","text":"**judge pairwise（范围可配）**\n全量，或按条目数／对数设上限子采样；**不绑定人工范围**","x":280,"y":700,"width":320,"height":90,"color":"5"},
		{"id":"d3","type":"text","text":"**日常态＝全自动跑完**\njudge 全量数据即全部数据，无人工等待环节","x":280,"y":850,"width":320,"height":80,"color":"5"},
		{"id":"f1","type":"text","text":"**出报告（主数据源按人工介入切换）**\n不介入／只开定向筛查 → ③ 层只列裁判配置版本\n开了随机抽检 → ③ 层列 κ／一致率（随 CI／样本量标注、κ 旁参考带），只展示不判定\n全量 → 人工数据正主、judge 交叉验证","x":280,"y":990,"width":340,"height":130,"color":"4"},
		{"id":"n1","type":"text","text":"**配置可改、重跑出报告**\njudge 数据每次全量重算；人工数据不绑配置；报告按次快照（当次配置＋运行 ID）","x":-80,"y":560,"width":280,"height":130,"color":"4"},
		{"id":"n2","type":"text","text":"**人工介入＝可选，四条通道**\n不介入（默认）／随机抽检／定向筛查／全量\n全量与另两者互斥；随机抽检与定向筛查各自开关、各自定数量，可单开可同开","x":-80,"y":730,"width":280,"height":150,"color":"4"},
		{"id":"e0","type":"text","text":"**随机抽检（可选）**\n随机抽 N 条人工打分 → 总体 κ／一致率（校准证据来源，全量同理）\n**不依赖 judge**：可先跑、可并行","x":680,"y":290,"width":340,"height":100,"color":"6"},
		{"id":"e1","type":"text","text":"**定向筛查（可选）**\n只挑 judge 认为有问题的条目 N 条（幻觉／低分／胜负分歧）→ 查准率＋badcase 清单\n**必须等 judge 跑完**","x":680,"y":430,"width":340,"height":120,"color":"6"},
		{"id":"e2","type":"text","text":"**人工打分（按模式勾选）**\n维度人工＝单点五档＋幻觉二选；对比人工＝pairwise 整体比（双序交换）；记录带标注者身份","x":680,"y":590,"width":340,"height":90,"color":"6"},
		{"id":"e3","type":"text","text":"读数\nκ／一致率（随机抽检）· 查准率（定向筛查，不进可信度层）","x":680,"y":720,"width":340,"height":90,"color":"6"},
		{"id":"i1","type":"text","text":"**打回重标**\n不满意的条目 → 重试列表（现成机制）重打；重打后重跑评测","x":1080,"y":590,"width":250,"height":90,"color":"6"},
		{"id":"r1","type":"text","text":"① 排名：BT（Elo 为备选）＋CI（基准入池给相对参照位置）","x":620,"y":1170,"width":360,"height":46},
		{"id":"r2","type":"text","text":"② 维度：均分±CI","x":620,"y":1222,"width":360,"height":46},
		{"id":"r3","type":"text","text":"③ 可信度：只列本次实际有的证据——κ／对比评估一致率（取自随机抽检）· 各裁判 κ · 校准集规模 · CI 与样本量标注（κ 旁参考带）· 裁判配置版本","x":620,"y":1274,"width":360,"height":64},
		{"id":"r4","type":"text","text":"④ badcase：按错误类型聚合（judge 理由＋人工低分条目）· 定向筛查查准率","x":620,"y":1344,"width":360,"height":46},
		{"id":"r5","type":"text","text":"⑤ 可复现：评测集来源与许可 · 批次快照 · 裁判快照 · 人工校准数据 · 工具版本","x":620,"y":1396,"width":360,"height":46}
	],
