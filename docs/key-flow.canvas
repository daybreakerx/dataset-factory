		{"id":"b0d88c6f8a5e4bbb","type":"group","x":1000,"y":140,"width":420,"height":345,"color":"#8b5cf6","label":"工作目录维护链（不进打标主流程）"},
		{"id":"25344676d2894ae7","type":"group","x":1000,"y":600,"width":420,"height":270,"color":"#64748b","label":"库源（应用时复制入快照）"},
		{"id":"185b33206ae346e5","type":"text","text":"# 一轮打标关键流程","x":0,"y":0,"width":900,"height":50},
		{"id":"655a7740e1544ee8","type":"text","text":"**素材导入**\n\n图片 jpg/jpeg/png/webp/gif\n视频 mp4/mov/webm/avi/mkv/m4v","x":320,"y":110,"width":340,"height":110,"color":"#64748b"},
		{"id":"7b2c143cbed0461c","type":"text","text":"**登记 imports.jsonl**\n\n哈希 / 相对路径 / 白名单状态\n复制导入（源文件不动）或就地采用","x":320,"y":250,"width":340,"height":110,"color":"#3b82f6"},
		{"id":"92d393f4ba954625","type":"text","text":"◇ **白名单与大小护栏？**\n\n图片≤20MB · 视频≤100MB\n平铺不递归","x":320,"y":390,"width":340,"height":110,"color":"#d97706"},
		{"id":"523d3f141006496a","type":"text","text":"**建批：策略 × 工作目录**\n\n两来源：素材组 / 工作目录\n配对冲突默认入包","x":320,"y":530,"width":340,"height":110,"color":"#3b82f6"},
		{"id":"00f4c096309d4682","type":"text","text":"**应用库策略生成快照 sN.json**\n\n自包含冻结、可跨目录复用\n手改/损坏可发现，旧快照不报错","x":320,"y":670,"width":340,"height":110,"color":"#3b82f6"},
		{"id":"ca521ffa8beb4c01","type":"text","text":"**串行流式跑批**\n\n占用锁并发拒绝 · 排队中可覆盖发车\n停止两档：已完成保留 / 已中断停因，可续跑","x":320,"y":810,"width":340,"height":130,"color":"#3b82f6"},
		{"id":"a11a110032674e32","type":"text","text":"**调 llm 能力层**\n\nSSE start/delta/done · 六分组监控\n视频取首帧 · 思考不入产物","x":320,"y":1070,"width":340,"height":110,"color":"#3b82f6"},
		{"id":"7b51943fe07b4532","type":"text","text":"**拒绝并登记原因**（不入批次）","x":-130,"y":425,"width":260,"height":60,"color":"#ef4444"},
		{"id":"8fad117495ae43f7","type":"text","text":"提示词库 prompts","x":1020,"y":620,"width":380,"height":50},
		{"id":"42e70639c2074317","type":"text","text":"技能包 skills","x":1020,"y":705,"width":380,"height":50},
		{"id":"265b21bd6fe84058","type":"text","text":"端点配置 endpoints","x":1020,"y":790,"width":380,"height":50},
		{"id":"47224e2079054346","type":"text","text":"清理派生物：三类并集任务化，完成后真删","x":1020,"y":190,"width":380,"height":50},
		{"id":"8e5ea9010db74e07","type":"text","text":"未导入文件：一键导入 / 直接永久删除","x":1020,"y":250,"width":380,"height":50},
		{"id":"3e51cade6c8a4560","type":"text","text":"删批次连带运行记录 → quarantine 可恢复","x":1020,"y":310,"width":380,"height":50},
		{"id":"fbb5617ebdff479b","type":"text","text":"目录迁移：前后端同锁、目标空分层校验、三态","x":1020,"y":370,"width":380,"height":75},
		{"id":"bb08ce2821be4366","type":"text","text":"◇ **哈希命中已完成？**","x":320,"y":980,"width":340,"height":50,"color":"#d97706"},
		{"id":"2234e0feea7c4532","type":"text","text":"**退避重试**\n\n429 遵循 Retry-After\n1/2/4s+抖动，最多 3 次","x":-220,"y":1080,"width":260,"height":130,"color":"#d97706"},
		{"id":"b08ceb802e25417e","type":"text","text":"**导出包交付**","x":320,"y":2000,"width":340,"height":70,"color":"#64748b"},
		{"id":"818426b02b3946f2","type":"text","text":"**zip 平铺导出**\n\n001 三位定宽图文配对\n非 ASCII 重命名 · 无 manifest · 凭据不入包","x":320,"y":1820,"width":340,"height":150,"color":"#16a34a"},
		{"id":"5f4a50aff4444e45","type":"text","text":"**生成打包计划**\n\n入包资格判定 · 将入包/被排除两清单逐条列原因\n打包前完整性哈希校验","x":320,"y":1640,"width":340,"height":150,"color":"#3b82f6"},
		{"id":"23196a82fc6b4ab2","type":"text","text":"◇ **还有条目？**","x":320,"y":1480,"width":340,"height":90,"color":"#d97706"},
		{"id":"6b454f43d3b44e58","type":"text","text":"**入失败分组**（停止仍保留产物）\n\n失败入常驻重试列表，跨会话持久","x":1020,"y":1210,"width":380,"height":90,"color":"#ef4444"},
		{"id":"3d71acad49fb4acb","type":"text","text":"**写产物 sN__主干.txt**\n\n与 items.jsonl","x":320,"y":1340,"width":340,"height":90,"color":"#16a34a"},
		{"id":"7676729fa4ca4183","type":"text","text":"◇ **结果分类**\n\n可重试？","x":320,"y":1210,"width":340,"height":90,"color":"#d97706"}
